{
  "name": "repoview",
  "version": "0.6.0",
  "private": false,
  "type": "module",
  "description": "GitHub-like repo browsing for local Git repositories (Markdown, live reload, broken link scanner).",
  "homepage": "https://github.com/h4x3rotab/repoview#readme",
  "bugs": {
    "url": "https://github.com/h4x3rotab/repoview/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/h4x3rotab/repoview.git"
  },
  "license": "MIT",
  "author": "Hang Yin <hangyin@phala.com>",
  "bin": {
    "repoview": "dist/cli.js"
  },
  "files": [
    "dist/",
    "public/",
    "README.md",
    "LICENSE",
    "DEVELOPMENT.md",
    "CONTRIBUTING.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "git",
    "repository",
    "viewer",
    "markdown",
    "github",
    "docs",
    "live-reload"
  ],
  "scripts": {
    "build": "tsc",
    "start": "tsx src/cli.ts",
    "dev": "tsx src/cli.ts --watch",
    "lint": "tsc --noEmit",
    "prepack": "npm run build",
    "test": "npm run build && node --test \"tests/integration/**/*.test.mjs\"",
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "npx playwright test --headed"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "diff2html": "^3.4.56",
    "express": "^4.21.2",
    "github-markdown-css": "^5.8.1",
    "github-slugger": "^2.0.0",
    "highlight.js": "^11.11.1",
    "ignore": "^7.0.5",
    "katex": "^0.16.22",
    "markdown-it": "^14.1.0",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.12.0",
    "mime-types": "^2.1.35",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/express": "^4.17.25",
    "@types/markdown-it": "^14.1.2",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^25.9.1",
    "@types/sanitize-html": "^2.16.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
